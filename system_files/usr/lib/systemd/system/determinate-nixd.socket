[Unit]
Description=Determinate Nixd Daemon Socket
# The store is extracted into the persistent /var/nix by nix-store-seed
# before anything may use /nix; fail loudly if the seed fails.
After=nix-store-seed.service
Requires=nix-store-seed.service
Before=multi-user.target
RequiresMountsFor=/nix/store
RequiresMountsFor=/nix/var/determinate

[Socket]
FileDescriptorName=determinate-nixd.socket
DirectoryMode=0755
ListenStream=/nix/var/determinate/determinate-nixd.socket
Service=nix-daemon.service

[Install]
WantedBy=sockets.target
