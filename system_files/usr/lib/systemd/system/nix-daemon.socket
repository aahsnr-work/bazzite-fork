[Unit]
Description=Determinate Nix Daemon Socket
# The store is extracted into the persistent /var/nix by nix-store-seed
# before anything may use /nix; fail loudly if the seed fails.
After=nix-store-seed.service
Requires=nix-store-seed.service
Before=multi-user.target
RequiresMountsFor=/nix/store
RequiresMountsFor=/nix/var
RequiresMountsFor=/nix/var/nix/db
ConditionPathIsReadWrite=/nix/var/nix/daemon-socket

[Socket]
FileDescriptorName=nix-daemon.socket
ListenStream=/nix/var/nix/daemon-socket/socket

[Install]
WantedBy=sockets.target
