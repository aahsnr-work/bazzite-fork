[Unit]
Description=Apply the home-manager configuration for the user
After=graphical-session-pre.target
ConditionPathExists=|%h/.config/home-manager/home.nix
ConditionPathExists=|%h/.config/home-manager/flake.nix
ConditionPathExists=!%h/.cache/home-manager-init-done

[Service]
Type=oneshot
# The dotfiles (chezmoi-init.service) have already placed the configuration in
# ~/.config/home-manager; apply it. If the Nix profile has no home-manager yet
# (the build-time bake failed), fall back to nix run.
ExecStart=/usr/bin/bash -c 'set -e; if ! command -v home-manager >/dev/null 2>&1; then nix run nixpkgs#home-manager -- switch -b backup --flake %h/.config/home-manager; elif [[ -f %h/.config/home-manager/flake.nix ]]; then home-manager switch -b backup --flake %h/.config/home-manager; else home-manager switch -b backup -f %h/.config/home-manager/home.nix; fi'
ExecStartPost=/usr/bin/touch %h/.cache/home-manager-init-done
TimeoutStartSec=3600

[Install]
WantedBy=default.target
